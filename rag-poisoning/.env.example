# This lab's target is an LLM app and needs an API key to answer.
# Use the key for whichever provider TARGET_BASE_URL points at (DeepInfra by default).
TARGET_API_KEY=

# Optional OpenAI-compatible endpoint. Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
# TARGET_BASE_URL=https://api.deepinfra.com/v1/openai

# Optional target model (default: meta-llama/Meta-Llama-3.1-8B-Instruct).
# TARGET_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
